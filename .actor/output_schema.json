{
  "actorOutputSchemaVersion": 1,
  "title": "AllEvents.in Scraper Output",
  "description": "Event listings scraped from AllEvents.in with complete details",
  "type": "object",
  "properties": {
    "title": {
      "title": "Event Title",
      "type": "string",
      "description": "Name of the event"
    },
    "url": {
      "title": "Event URL",
      "type": "string",
      "description": "Full URL to the event page"
    },
    "date": {
      "title": "Event Date",
      "type": "string",
      "description": "Event date"
    },
    "time": {
      "title": "Event Time",
      "type": "string",
      "description": "Event start time"
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "Event venue or location"
    },
    "category": {
      "title": "Category",
      "type": "string",
      "description": "Event category (music, arts, sports, etc.)"
    },
    "price": {
      "title": "Price",
      "type": "string",
      "description": "Ticket price or 'Free'"
    },
    "description": {
      "title": "Description",
      "type": "string",
      "description": "Event description text"
    },
    "image": {
      "title": "Image URL",
      "type": "string",
      "description": "Event poster/image URL"
    },
    "organizer": {
      "title": "Organizer",
      "type": "string",
      "description": "Event organizer name"
    },
    "phone": {
      "title": "Phone",
      "type": "string",
      "description": "Contact phone number"
    },
    "email": {
      "title": "Email",
      "type": "string",
      "description": "Contact email address"
    }
  },
  "required": ["title", "url"]
}
